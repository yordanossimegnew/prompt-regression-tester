# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...
VOYAGE_API_KEY=pa-...          # only needed for similarity grading

# PostgreSQL: runs, outputs, grades and the output cache
#   In psql:  CREATE DATABASE prompt_regression;  CREATE DATABASE prompt_regression_test;
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/prompt_regression
# Used only by pytest (tables are truncated between tests: never point this at real data)
TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/prompt_regression_test

# Optional
JUDGE_MODEL=claude-opus-5-5
VOYAGE_MODEL=voyage-3.5
MAX_CONCURRENCY=8
LOG_LEVEL=INFO
